# =============================================================================
# Express.js Application Environment Configuration Template
# =============================================================================
#
# This file serves as a template for environment variables required by the
# Express.js application. Copy this file to `.env` and customize the values
# for your environment.
#
# USAGE:
#   cp .env.example .env
#   # Edit .env with your specific configuration
#
# SECURITY NOTE:
#   - The .env file should NEVER be committed to version control
#   - This .env.example file is safe to commit as it contains only defaults
#   - Keep sensitive values (API keys, secrets) only in your local .env file
#
# =============================================================================

# -----------------------------------------------------------------------------
# APPLICATION ENVIRONMENT
# -----------------------------------------------------------------------------
# Determines the application runtime mode and affects logging, error handling,
# and other environment-specific behaviors.
#
# Valid values:
#   - development : Enables verbose logging, detailed error messages with stack traces
#   - production  : Optimized for performance, minimal logging, sanitized error messages
#   - test        : Used for running automated tests
#
# Default: development
# -----------------------------------------------------------------------------
NODE_ENV=development

# -----------------------------------------------------------------------------
# SERVER CONFIGURATION
# -----------------------------------------------------------------------------

# PORT - The port number the HTTP server will listen on
#
# The server will bind to this port to accept incoming HTTP connections.
# Ports 1-1024 are privileged and require elevated permissions (root/admin).
# For production behind a reverse proxy (nginx, Apache), this can be any
# unprivileged port (>1024) as the proxy handles external port 80/443.
#
# Valid values: 1-65535 (integers only)
# Common choices: 3000 (development), 8080 (alternative), 80 (production direct)
#
# Default: 3000
# -----------------------------------------------------------------------------
PORT=3000

# HOST - The network interface address the server binds to
#
# Controls which network interfaces the server accepts connections from.
# This is critical for security in different deployment scenarios.
#
# Valid values:
#   - 127.0.0.1 : Localhost only - accepts connections only from the same machine
#                 (recommended for development or when behind a local reverse proxy)
#   - 0.0.0.0   : All interfaces - accepts connections from any network interface
#                 (required for Docker containers, cloud deployments, or direct access)
#   - <IP>      : Specific IP address - binds to a particular network interface
#
# Security considerations:
#   - Use 127.0.0.1 in development to prevent external access
#   - Use 0.0.0.0 in production containers/cloud environments
#   - When using 0.0.0.0, ensure firewall rules are properly configured
#
# Default: 0.0.0.0
# -----------------------------------------------------------------------------
HOST=0.0.0.0

# -----------------------------------------------------------------------------
# LOGGING CONFIGURATION
# -----------------------------------------------------------------------------

# LOG_LEVEL - Controls the verbosity of application logging (Winston logger)
#
# Sets the minimum severity level for log messages to be recorded.
# Messages at the specified level and above (more severe) will be logged.
#
# Valid values (in order of decreasing verbosity):
#   - error : Only log errors (highest severity, least verbose)
#   - warn  : Log warnings and errors
#   - info  : Log informational messages, warnings, and errors (recommended for production)
#   - http  : Log HTTP requests plus all above levels
#   - verbose : More detailed informational logging
#   - debug : Detailed debugging information (recommended for development)
#   - silly : Most verbose, logs everything
#
# Recommendations:
#   - Production: info or warn (balance between visibility and performance)
#   - Development: debug (full visibility for troubleshooting)
#   - Troubleshooting: debug or verbose (temporary increase for issue investigation)
#
# Default: info
# -----------------------------------------------------------------------------
LOG_LEVEL=info
