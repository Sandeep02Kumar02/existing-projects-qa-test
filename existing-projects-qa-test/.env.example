# Environment Variables Template
# Copy this file to .env and configure for your environment

# Environment mode
# Options: development, production, test, staging
FLASK_ENV=development
NODE_ENV=development

# Server Configuration
# PORT: The TCP port the server binds to (1-65535)
PORT=3000

# HOST: The network interface to bind to
# Use 0.0.0.0 for all interfaces (production)
# Use 127.0.0.1 for localhost only (development security)
HOST=0.0.0.0

# Logging Configuration
# LOG_LEVEL: Controls logging verbosity
# Options: debug, info, warning, error, critical
LOG_LEVEL=info
